# Analytics
PUBLIC_GA_MEASUREMENT_ID=

# Optional: used for absolute canonical and social URLs in metadata
SITE_URL=

# Contact form — Resend (https://resend.com) API key for email delivery
# Create a free account, verify your domain, and paste the key here.
RESEND_API_KEY=

# Email address that contact form submissions are delivered to (defaults to info@morningtidecc.com)
CONTACT_TO_EMAIL=info@morningtidecc.com
