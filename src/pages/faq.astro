---
import Layout from '../layouts/Layout.astro';
import Accordion from '../components/Accordion.tsx';
import FadeIn from '../components/FadeIn.tsx';
import AnimatedText from '../components/AnimatedText.tsx';

const generalFaqs = [
	{
		q: 'What is MCC?',
		a: 'Morningtide Consulting and Collective (MCC) offers practice consulting and continuing education for mental health clinicians, founded by Dr. Heather Cornett, Ph.D., LP.',
	},
	{
		q: 'Who leads MCC?',
		a: 'Dr. Heather Cornett, a licensed psychologist with over a decade of clinical experience, former assistant professor, and active multi-state practice owner.',
	},
	{
		q: 'What services does MCC offer?',
		a: 'MCC offers practice consulting (billing, credentialing, PSYPACT navigation) and continuing education trainings on ADHD and autism assessment.',
	},
];

const consultingCeuFaqs = [
	{
		q: 'What is practice consulting?',
		a: 'Practice consulting provides direct support with billing, credentialing, paneling, PSYPACT navigation, and operational systems for running a sustainable practice.',
	},
	{
		q: 'What topics do the CEU trainings cover?',
		a: 'Trainings focus on ADHD assessment, autism evaluation, and clinical applications designed for immediate use in your practice.',
	},
	{
		q: 'Can trainings be customized for my group?',
		a: 'Yes. Reach out to discuss your specific training needs, and we can work with you on a customized program for your organization or group practice.',
	},
	{
		q: 'What formats are available?',
		a: 'Consulting and trainings are delivered remotely via secure video platforms. Trainings can also be delivered on-site for organizations and group practices.',
	},
	{
		q: 'How do I get started with consulting or training?',
		a: 'Use the contact form to share your consulting questions or training goals. We will follow up to discuss fit and next steps.',
	},
];

const gettingStartedFaqs = [
	{
		q: 'How do I reach out to MCC?',
		a: 'Contact us at info@morningtideconsulting.com or use the inquiry form on the website. We typically respond within 1-2 business days.',
	},
	{
		q: 'What payment methods do you accept?',
		a: 'Credit and debit cards, Zelle, and Venmo. Payment plans available for larger consulting engagements.',
	},
];
---

<Layout
	title="Frequently Asked Questions | Morningtide Consulting and Collective"
	description="Answers to common questions about MCC's consulting services, CEU trainings, practice operations guidance, and continuing education for clinicians."
>
	<main id="main-content" class="page-main">
		<section class="hero-shell mx-auto max-w-6xl space-y-8">
			<FadeIn delay={0}>
				<p class="eyebrow">FAQ</p>
			</FadeIn>
			<AnimatedText
				text="Frequently Asked Questions"
				as="h1"
				split="word"
				stagger={50}
				delay={100}
				class="max-w-4xl text-5xl leading-none text-(--color-ink) sm:text-6xl"
			/>
			<FadeIn delay={400}>
				<p class="max-w-3xl text-lg leading-8 text-(--color-muted)">
					Answers to the most common questions about our practice, the evaluation process, pricing, and logistics.
				</p>
			</FadeIn>
		</section>

		<section class="mx-auto mt-12 max-w-6xl space-y-10">
			<FadeIn>
				<div class="section-shell rounded-4xl p-8 lg:p-10">
					<p class="eyebrow">General</p>
					<div class="mt-6">
						<Accordion client:visible items={generalFaqs} />
					</div>
				</div>
			</FadeIn>

			<FadeIn delay={100}>
				<div class="section-shell rounded-4xl p-8 lg:p-10">
					<p class="eyebrow">Consulting & CEU</p>
					<div class="mt-6">
						<Accordion client:visible items={consultingCeuFaqs} />
					</div>
				</div>
			</FadeIn>

			<FadeIn delay={200}>
				<div class="section-shell rounded-4xl p-8 lg:p-10">
					<p class="eyebrow">Getting Started</p>
					<div class="mt-6">
						<Accordion client:visible items={gettingStartedFaqs} />
					</div>
				</div>
			</FadeIn>
		</section>

		<FadeIn>
			<section class="cta-strip mx-auto mt-10 max-w-6xl">
				<div class="grid gap-8 lg:grid-cols-3">
					<div>
						<p class="eyebrow">Still Have Questions?</p>
						<p class="mt-4 text-base leading-8 text-(--color-muted)">If something is not covered here, reach out directly. We are happy to answer questions about fit, process, or your specific referral question.</p>
					</div>
					<div>
						<p class="eyebrow">Ready to Start?</p>
						<p class="mt-4 text-base leading-8 text-(--color-muted)">If you already know what you need, skip straight to the inquiry form and we will follow up to discuss scheduling.</p>
					</div>
					<div>
						<p class="eyebrow">Get in Touch</p>
						<a class="mt-4 inline-flex rounded-full bg-(--color-accent) px-5 py-3 text-sm font-semibold text-(--color-button-ink) shadow-(--shadow-brand) transition-all duration-300 hover:-translate-y-0.5 hover:shadow-lg" href="/#contact">Start with an inquiry</a>
					</div>
				</div>
			</section>
		</FadeIn>
	</main>
</Layout>

