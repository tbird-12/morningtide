---
import { BookOpen, Briefcase, ExternalLink, GraduationCap } from 'lucide-react';
import Layout from '../layouts/Layout.astro';
import FadeIn from '../components/FadeIn.tsx';
import AnimatedText from '../components/AnimatedText.tsx';
import AnimatedCard from '../components/AnimatedCard.tsx';

const serviceCards = [
	{
		title: 'Consulting for clinicians',
		description: 'Practical support for billing, credentialing, PSYPACT questions, and the day-to-day operations that keep a practice sustainable.',
		href: '/services/billing-and-credentialing-consultation',
		icon: Briefcase,
	},
	{
		title: 'CEU trainings',
		description: 'Continuing education on ADHD, autism, and assessment methodology designed for immediate use in real clinical work.',
		href: '/services/ceu-trainings',
		icon: BookOpen,
	},
];

const differentiators = [
	{
		title: 'Grounded in Active Practice',
		description: 'Advice and trainings are shaped by the realities of running a real multi-state practice, not a theoretical model.',
	},
	{
		title: 'Direct, Practical Guidance',
		description: 'No fluff — just clear answers on billing, credentialing, PSYPACT, and the operational questions clinicians actually face.',
	},
	{
		title: 'CEUs That Transfer',
		description: 'Trainings are built for immediate clinical application so what you learn is useful the next time you see a client.',
	},
];

const heroChips = [
	{ label: 'Practice Consulting', icon: Briefcase },
	{ label: 'CEU Trainings', icon: GraduationCap },
];
---

<Layout
	title="Morningtide Consulting and Collective | Consulting and CEU trainings for clinicians"
	description="Consulting and continuing education for mental health professionals."
>
	<main id="main-content" class="page-main">
		<section class="hero-shell relative overflow-hidden">
			<div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_top_left,var(--color-brand-soft),transparent_32%),radial-gradient(circle_at_85%_12%,var(--color-accent-soft),transparent_24%)]"></div>
			<div class="mx-auto flex max-w-5xl flex-col items-center text-center">
				<!-- Hero image placeholder: when added, use fetchpriority="high" on the primary hero image. -->
				<FadeIn delay={0} duration={800}>
					<p class="eyebrow">Morningtide Consulting and Collective</p>
				</FadeIn>
				<AnimatedText
					text="Consulting and continuing education for mental health professionals."
					as="h1"
					split="word"
					stagger={40}
					delay={150}
					duration={600}
					class="mt-6 max-w-4xl text-wrap-balance text-5xl leading-none text-(--color-ink) sm:text-6xl lg:text-7xl"
				/>
				<FadeIn delay={500}>
					<p class="mt-8 max-w-3xl text-lg leading-8 text-(--color-muted) sm:text-xl">
						Practical support for billing, credentialing, PSYPACT navigation, and continuing education designed for real clinical work.
					</p>
				</FadeIn>
				<FadeIn delay={700}>
					<div class="visual-grid mt-8 w-full max-w-3xl">
						{heroChips.map(({ label, icon: Icon }) => (
							<p class="visual-chip">
								<Icon className="h-4 w-4" aria-hidden="true" />
								<span>{label}</span>
							</p>
						))}
					</div>
				</FadeIn>
				<FadeIn delay={900}>
					<div class="mt-10 flex flex-wrap justify-center gap-4">
						<a class="inline-flex min-h-11 items-center rounded-full bg-(--color-accent) px-6 py-3 text-sm font-semibold text-(--color-button-ink) shadow-(--shadow-brand) transition-all duration-300 hover:-translate-y-0.5 hover:shadow-lg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--color-brand)" href="/#contact">
							Book a Consultation
						</a>
						<a class="inline-flex min-h-11 items-center rounded-full border border-(--color-line) bg-(--color-surface) px-6 py-3 text-sm font-semibold text-(--color-ink) transition-all duration-300 hover:-translate-y-0.5 hover:shadow focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--color-brand)" href="/services/ceu-trainings">
							View CEU Trainings
						</a>
					</div>
				</FadeIn>
			</div>
		</section>

		<section class="home-section">
			<div class="mx-auto w-full max-w-6xl space-y-10 px-4 sm:px-6 lg:px-10">
				<FadeIn>
					<div class="max-w-3xl space-y-4">
						<p class="eyebrow">Primary Services</p>
						<h2 class="text-4xl leading-none text-(--color-ink) sm:text-5xl">What Morningtide Leads With</h2>
						<p class="text-lg leading-8 text-(--color-muted)">
							Morningtide is built first for clinician-facing work: strategic consulting and continuing education that support better care and stronger operations.
						</p>
					</div>
				</FadeIn>
				<div class="grid gap-6 lg:grid-cols-2">
					{serviceCards.map((service, i) => {
						const Icon = service.icon;
						return (
							<AnimatedCard href={service.href} index={i} className="section-shell rounded-4xl p-8 hover:-translate-y-1">
								<div class="flex items-center gap-3">
									<div class="flex h-11 w-11 items-center justify-center rounded-2xl bg-(--color-section-tint) text-(--color-brand)">
										<Icon className="h-5 w-5" aria-hidden="true" />
									</div>
									<h3 class="mb-0 text-3xl leading-none text-(--color-ink)">{service.title}</h3>
								</div>
								<p class="mt-5 max-w-xl text-base leading-8 text-(--color-muted)">{service.description}</p>
								<span class="mt-8 inline-flex items-center text-sm font-semibold text-(--color-accent)">
									Learn more
								</span>
							</AnimatedCard>
						);
					})}
				</div>
			</div>
		</section>

		<section class="home-section bg-(--color-section-tint)">
			<div class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-10">
				<FadeIn class="section-shell rounded-4xl">
					<p class="eyebrow">Meet Dr. Cornett</p>
					<p class="mt-6 max-w-4xl text-base leading-8 text-(--color-muted)">
						Led by Dr. Heather Cornett, Ph.D., LP — licensed psychologist and practice operations expert. <a class="inline-flex items-center gap-1 font-semibold text-(--color-accent) underline underline-offset-4 transition-colors duration-200 hover:text-(--color-brand) focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--color-brand)" href="/about">Learn more</a>
					</p>
				</FadeIn>
			</div>
		</section>

		<section class="home-section">
			<div class="mx-auto w-full max-w-6xl space-y-10 px-4 sm:px-6 lg:px-10">
				<FadeIn>
					<div class="max-w-3xl space-y-4">
						<p class="eyebrow">Why MCC</p>
						<h2 class="text-4xl leading-none text-(--color-ink) sm:text-5xl">Built for Clinicians Who Want Useful Answers</h2>
					</div>
				</FadeIn>
				<div class="grid gap-6 lg:grid-cols-3">
					{differentiators.map((item, i) => (
						<AnimatedCard index={i} stagger={140} className="rounded-[1.75rem] p-6">
							<h3 class="mb-0 text-2xl leading-tight text-(--color-ink)">{item.title}</h3>
							<p class="mt-4 text-base leading-8 text-(--color-muted)">{item.description}</p>
						</AnimatedCard>
					))}
				</div>
			</div>
		</section>

		<section id="contact" class="home-section">
			<div class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-10">
				<FadeIn class="section-shell rounded-4xl">
					<div class="mx-auto max-w-3xl space-y-6 text-center">
						<p class="eyebrow">Ready to work together?</p>
						<AnimatedText
							text="Let’s talk about your consulting or training needs."
							as="h2"
							split="word"
							stagger={60}
							delay={100}
							class="text-4xl leading-none text-(--color-ink) sm:text-5xl"
						/>
						<FadeIn delay={300}>
							<p class="text-lg leading-8 text-(--color-muted)">
								Reach out with your consulting questions, training goals, or practice needs, and we’ll follow up to find the right next step.
							</p>
							<div class="flex flex-wrap justify-center gap-4 pt-4">
								<a class="inline-flex min-h-11 items-center rounded-full bg-(--color-accent) px-6 py-3 text-sm font-semibold text-(--color-button-ink) shadow-(--shadow-brand) transition-all duration-300 hover:-translate-y-0.5 hover:shadow-lg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--color-brand)" href="mailto:info@morningtideconsulting.com">
									Start an inquiry
								</a>
								<a class="inline-flex min-h-11 items-center rounded-full border border-(--color-line) bg-(--color-surface) px-6 py-3 text-sm font-semibold text-(--color-ink) transition-all duration-300 hover:-translate-y-0.5 hover:shadow focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--color-brand)" href="/services">
									Browse services
								</a>
							</div>
						</FadeIn>
					</div>
				</FadeIn>
			</div>
		</section>
	</main>
</Layout>

<style>
	.home-section {
		padding-block: clamp(3.5rem, 8vw, 5.5rem);
	}
</style>

