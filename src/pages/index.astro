---
import { BookOpen, Briefcase, GraduationCap, Shield, MapPin } from 'lucide-react';
import Layout from '../layouts/Layout.astro';
import FadeIn from '../components/FadeIn.tsx';
import AnimatedText from '../components/AnimatedText.tsx';
import AnimatedCard from '../components/AnimatedCard.tsx';
import ContactForm from '../components/ContactForm.tsx';
import { contactInfo } from '../data';

const serviceCards = [
	{
		title: 'Consulting for clinicians',
		description: 'Practical support for billing, credentialing, PSYPACT questions, and the day-to-day operations that keep a practice sustainable.',
		href: '/services/billing-and-credentialing-consultation',
		icon: Briefcase,
	},
	{
		title: 'CEU trainings',
		description: 'Continuing education on ADHD, autism, and assessment methodology designed for immediate use in real clinical work.',
		href: '/services/ceu-trainings',
		icon: BookOpen,
	},
];

const differentiators = [
	{
		title: 'Grounded in Active Practice',
		description: 'Advice and trainings are shaped by the realities of running a real multi-state practice, not a theoretical model.',
	},
	{
		title: 'Direct, Practical Guidance',
		description: 'No fluff — just clear answers on billing, credentialing, PSYPACT, and the operational questions clinicians actually face.',
	},
	{
		title: 'CEUs That Transfer',
		description: 'Trainings are built for immediate clinical application so what you learn is useful the next time you see a client.',
	},
];

const trustCredentials = [
	{ icon: GraduationCap, label: 'Ph.D., Licensed Psychologist' },
	{ icon: Shield, label: 'PSYPACT Authorized' },
	{ icon: MapPin, label: 'Licensed in KY & NM' },
	{ icon: Briefcase, label: '10+ Years Clinical Practice' },
];
---

<Layout
	title="Morningtide Consulting and Collective | Consulting and CEU trainings for clinicians"
	description="Consulting and continuing education for mental health professionals."
>
	<main id="main-content" class="page-main">
		<section class="hero-shell relative overflow-hidden">
			<div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_top_left,var(--color-brand-soft),transparent_32%),radial-gradient(circle_at_85%_12%,var(--color-accent-soft),transparent_24%)]"></div>
			<div class="mx-auto flex max-w-5xl flex-col items-center text-center">
				<FadeIn delay={0} duration={800}>
					<p class="eyebrow">Morningtide Consulting and Collective</p>
				</FadeIn>
				<AnimatedText
					text="Consulting and continuing education for mental health professionals."
					as="h1"
					split="word"
					stagger={40}
					delay={150}
					duration={600}
					class="mt-6 max-w-4xl text-wrap-balance text-5xl leading-none text-ink sm:text-6xl lg:text-7xl"
				/>
				<FadeIn delay={500}>
					<p class="mt-8 max-w-3xl text-lg leading-8 text-muted sm:text-xl">
						Practical support for billing, credentialing, PSYPACT navigation, and continuing education designed for real clinical work.
					</p>
				</FadeIn>
				<FadeIn delay={900}>
					<div class="mt-10 flex flex-wrap justify-center gap-4">
						<a class="inline-flex min-h-11 items-center rounded-full bg-accent px-6 py-3 text-sm font-semibold text-button-ink shadow-brand transition-all duration-300 hover:-translate-y-0.5 hover:shadow-lg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand" href="/#contact">
							Book a Consultation
						</a>
						<a class="inline-flex min-h-11 items-center rounded-full border border-line bg-surface px-6 py-3 text-sm font-semibold text-ink transition-all duration-300 hover:-translate-y-0.5 hover:shadow focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand" href="/services/ceu-trainings">
							View CEU Trainings
						</a>
					</div>
				</FadeIn>

					<!-- Trust credentials bar -->
					<FadeIn delay={1100}>
						<div class="mt-12 flex flex-wrap items-center justify-center gap-x-8 gap-y-3 border-t border-line-soft pt-8">
							{trustCredentials.map(({ icon: Icon, label }) => (
								<div class="flex items-center gap-2 text-xs font-semibold text-muted">
									<Icon className="h-4 w-4 shrink-0 text-brand" aria-hidden="true" />
									<span>{label}</span>
								</div>
							))}
						</div>
					</FadeIn>
			</div>
		</section>

		<section class="home-section">
			<div class="mx-auto w-full max-w-6xl space-y-10 px-4 sm:px-6 lg:px-10">
				<FadeIn>
					<div class="max-w-3xl space-y-4">
						<p class="eyebrow">Primary Services</p>
						<h2 class="text-4xl leading-none text-ink sm:text-5xl">Why Choose Morningtide Consulting</h2>
						<p class="text-lg leading-8 text-muted">
							Morningtide is built first for clinician-facing work: strategic consulting and continuing education that support better care and stronger operations.
						</p>
					</div>
				</FadeIn>
				<div class="grid gap-6 lg:grid-cols-2">
					{serviceCards.map((service, i) => {
						const Icon = service.icon;
						return (
							<AnimatedCard href={service.href} index={i} className="section-shell rounded-4xl p-8 hover:-translate-y-1">
								<div class="flex items-center gap-3">
									<div class="flex h-11 w-11 items-center justify-center rounded-2xl bg-section-tint text-brand">
										<Icon className="h-5 w-5" aria-hidden="true" />
									</div>
									<h3 class="mb-0 text-3xl leading-none text-ink">{service.title}</h3>
								</div>
								<p class="mt-5 max-w-xl text-base leading-8 text-muted">{service.description}</p>
								<span class="mt-8 inline-flex items-center text-sm font-semibold text-accent">
									Learn more
								</span>
							</AnimatedCard>
						);
					})}
				</div>
			</div>
		</section>

		<section class="home-section bg-section-tint">
			<div class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-10">
				<FadeIn class="section-shell rounded-4xl">
					<p class="eyebrow">Meet Dr. Cornett</p>
					<p class="mt-6 max-w-4xl text-base leading-8 text-muted">
						Led by Dr. Heather Cornett, Ph.D., LP — licensed psychologist and practice operations expert. <a class="inline-flex items-center gap-1 font-semibold text-accent-text underline underline-offset-4 transition-colors duration-200 hover:text-brand focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand" href="/about">Learn more</a>
					</p>
				</FadeIn>
			</div>
		</section>

		<section class="home-section">
			<div class="mx-auto w-full max-w-6xl space-y-10 px-4 sm:px-6 lg:px-10">
				<FadeIn>
					<div class="max-w-3xl space-y-4">
						<p class="eyebrow">Why MCC</p>
						<h2 class="text-4xl leading-none text-ink sm:text-5xl">Built for Clinicians Who Want Useful Answers</h2>
					</div>
				</FadeIn>
				<div class="grid gap-6 lg:grid-cols-3">
					{differentiators.map((item, i) => (
						<AnimatedCard index={i} stagger={140} className="rounded-[1.75rem] p-6">
							<h3 class="mb-0 text-2xl leading-tight text-ink">{item.title}</h3>
							<p class="mt-4 text-base leading-8 text-muted">{item.description}</p>
						</AnimatedCard>
					))}
				</div>
			</div>
		</section>

		<section id="contact" class="home-section">
			<div class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-10">
				<FadeIn class="section-shell rounded-4xl">
					<div class="grid gap-12 lg:grid-cols-[1fr_1.2fr] lg:gap-16">
						<!-- Left: value prop + contact info -->
						<div class="space-y-6">
							<div class="space-y-4">
								<p class="eyebrow">Ready to work together?</p>
								<h2 class="text-4xl leading-none text-ink sm:text-5xl">Let's talk about your practice needs.</h2>
								<p class="text-base leading-8 text-muted">
									Whether you need consulting on billing, credentialing, or PSYPACT — or you're interested in a CEU training — reach out and we'll figure out the right next step together.
								</p>
							</div>

							<div class="space-y-3 pt-2">
								<div class="flex items-center gap-3 text-sm font-semibold text-muted">
									<svg class="h-4 w-4 shrink-0 text-brand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
									<a href={`mailto:${contactInfo.email}`} class="hover:text-ink transition-colors">{contactInfo.email}</a>
								</div>
								<div class="flex items-center gap-3 text-sm font-semibold text-muted">
									<svg class="h-4 w-4 shrink-0 text-brand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13.5a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.56 3h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l.81-.81a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 17z"/></svg>
									<a href={`tel:${contactInfo.phone}`} class="hover:text-ink transition-colors">{contactInfo.phoneDisplay}</a>
								</div>
								<div class="flex items-center gap-3 text-sm font-semibold text-muted">
									<svg class="h-4 w-4 shrink-0 text-brand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>
									<span>Remote / Virtual Sessions</span>
								</div>
								<div class="flex items-center gap-3 text-sm font-semibold text-muted">
									<svg class="h-4 w-4 shrink-0 text-brand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
									<span>Response within 1–2 business days</span>
								</div>
							</div>
						</div>

						<!-- Right: contact form island -->
						<div class="rounded-3xl border border-line-soft bg-surface p-6 shadow-medium sm:p-8">
							<ContactForm client:visible />
						</div>
					</div>
				</FadeIn>
			</div>
		</section>
	</main>
</Layout>

<style>
	.home-section {
		padding-block: clamp(3.5rem, 8vw, 5.5rem);
	}
</style>

