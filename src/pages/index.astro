---
import { BookOpen, Briefcase, GraduationCap, Shield, MapPin, Tag, HelpCircle, ExternalLink } from 'lucide-react';
import Layout from '../layouts/Layout.astro';
import FadeIn from '../components/FadeIn.tsx';
import AnimatedText from '../components/AnimatedText.tsx';
import AnimatedCard from '../components/AnimatedCard.tsx';
import ContactForm from '../components/ContactForm.tsx';
import { contactInfo } from '../data';

const trustCredentials = [
	{ icon: GraduationCap, label: 'Ph.D., Licensed Psychologist' },
	{ icon: Shield, label: 'PSYPACT Authorized' },
	{ icon: MapPin, label: 'Licensed in KY & NM' },
	{ icon: Briefcase, label: '10+ Years Practice' },
];

const credentials = [
	'Ph.D. in Counseling Psychology',
	'Licensed Psychologist (LP) — Kentucky & New Mexico',
	'PSYPACT Supervisor Credentials',
	'Former Assistant Professor, Departments of Psychology',
	'Over a decade of active clinical practice',
];

const serviceCards = [
	{
		title: 'Practice Consulting',
		description: 'Direct operational support on billing workflows, credentialing strategy, PSYPACT navigation, and the practice systems that actually sustain a clinical business.',
		href: '/consulting',
		icon: Briefcase,
		cta: 'Explore consulting',
	},
	{
		title: 'CEU Trainings',
		description: 'Continuing education on ADHD and autism assessment — designed for immediate clinical application so what you learn is useful the next time you see a client.',
		href: '/services/ceu-trainings',
		icon: BookOpen,
		cta: 'Browse trainings',
	},
];

const differentiators = [
	{
		title: 'Grounded in Active Practice',
		description: 'Advice shaped by the real systems and challenges of running a multi-state practice — not a theoretical model.',
	},
	{
		title: 'Direct, No-Fluff Guidance',
		description: 'Clear answers on billing, credentialing, PSYPACT, and the operational questions clinicians actually face.',
	},
	{
		title: 'CEUs That Transfer',
		description: 'Trainings built for immediate clinical application — useful the next time you see a client.',
	},
];

const populations = [
	'Solo practitioners and group practices',
	'Clinicians transitioning to private pay',
	'Multi-state and telehealth practices',
	'Clinicians building a testing arm',
	'Community mental health agencies',
	'Graduate training programs',
];

const resourceCards = [
	{
		icon: Tag,
		title: 'Pricing',
		description: 'Transparent information on consulting rates, CEU training costs, and payment options.',
		href: '/pricing',
		cta: 'View pricing',
	},
	{
		icon: HelpCircle,
		title: 'FAQ',
		description: 'Answers to common questions about consulting, CEU trainings, format, and how to get started.',
		href: '/faq',
		cta: 'Read the FAQ',
	},
];
---

<Layout
	title="Practice Consulting and CEU Trainings for Clinicians | Morningtide Consulting and Collective"
	description="Starting or growing a private practice is hard. Morningtide helps clinicians navigate billing, credentialing, PSYPACT, and continuing education — led by Dr. Heather Cornett, licensed psychologist."
>
	<main id="main-content" class="page-main">

		<!-- ── HERO ── -->
		<section class="hero-shell relative overflow-hidden">
			<div class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_90%_60%_at_50%_-15%,rgba(167,139,250,0.18),transparent),radial-gradient(ellipse_50%_35%_at_5%_0%,rgba(139,92,246,0.12),transparent),radial-gradient(ellipse_50%_35%_at_95%_5%,rgba(167,139,250,0.09),transparent)]"></div>
			<div class="mx-auto flex max-w-5xl flex-col items-center text-center">
				<FadeIn delay={0} duration={800}>
					<p class="eyebrow">Morningtide Consulting and Collective</p>
				</FadeIn>
				<AnimatedText
					text="Private practice is hard. You don't have to figure it out alone."
					as="h1"
					split="word"
					stagger={35}
					delay={150}
					duration={600}
					class="mt-6 max-w-4xl text-wrap-balance text-5xl leading-[1.08] text-ink sm:text-6xl lg:text-7xl"
				/>
				<FadeIn delay={600}>
					<p class="mt-8 max-w-3xl text-lg leading-8 text-muted sm:text-xl">
						Billing systems, credentialing, PSYPACT, practice operations — new clinicians hit all of it at once with no roadmap. Morningtide exists to change that, with direct guidance from someone who has built and run it herself.
					</p>
				</FadeIn>
				<FadeIn delay={950}>
					<div class="mt-10 flex flex-wrap justify-center gap-4">
						<a class="inline-flex min-h-11 items-center rounded-full bg-accent px-6 py-3 text-sm font-semibold text-button-ink shadow-brand transition-all duration-300 hover:-translate-y-0.5 hover:shadow-lg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand" href="#contact">
							Get Guidance
						</a>
						<a class="inline-flex min-h-11 items-center rounded-full border border-line bg-surface px-6 py-3 text-sm font-semibold text-ink transition-all duration-300 hover:-translate-y-0.5 hover:shadow focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand" href="#about">
							Meet Heather
						</a>
					</div>
				</FadeIn>
				<FadeIn delay={1150}>
					<div class="mt-12 flex flex-wrap items-center justify-center gap-x-8 gap-y-3 border-t border-line-soft pt-8">
						{trustCredentials.map(({ icon: Icon, label }) => (
							<div class="flex items-center gap-2 text-xs font-semibold text-muted">
								<Icon className="h-4 w-4 shrink-0 text-brand" aria-hidden="true" />
								<span>{label}</span>
							</div>
						))}
					</div>
				</FadeIn>
			</div>
		</section>

		<!-- ── ABOUT ── -->
		<section id="about" class="home-section bg-section-tint" aria-labelledby="about-heading">
			<div class="mx-auto grid max-w-6xl gap-6 px-4 sm:px-6 lg:grid-cols-[1fr_1.1fr] lg:px-10">
				<FadeIn class="premium-card rounded-4xl p-8">
					<p class="eyebrow">Meet Dr. Heather Cornett</p>
					<h2 id="about-heading" class="mt-4 text-4xl leading-none text-ink">The Guidance Comes From Someone Who Has Done It</h2>
					<ul class="mt-6 space-y-3 text-sm leading-7 text-muted">
						{credentials.map((item) => (
							<li class="flex gap-3">
								<span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-(--color-brand)"></span>
								<span>{item}</span>
							</li>
						))}
					</ul>
				</FadeIn>

				<FadeIn delay={120} class="premium-card rounded-4xl p-8">
					<p class="eyebrow">Her Background</p>
					<h3 class="mt-4 text-2xl leading-tight text-ink">From University Faculty to Multi-State Practice</h3>
					<p class="mt-4 text-base leading-8 text-muted">
						Dr. Cornett served as an Assistant Professor in Departments of Psychology, teaching graduate and postdoctoral students in assessment, psychopathology, and child psychology — while maintaining an active clinical practice throughout.
					</p>
					<p class="mt-4 text-base leading-8 text-muted">
						She later transitioned to a full-time multi-state private practice, building operational systems for billing, credentialing, PSYPACT navigation, and telehealth logistics from the ground up. That hands-on experience now drives her consulting and training work with other clinicians.
					</p>
					<p class="mt-6 text-sm text-muted">
						For clinical services including psychological evaluations, visit
						<a
							class="inline-flex items-center gap-1 font-semibold text-accent-text underline underline-offset-4 transition-colors duration-200 hover:text-brand focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
							href="https://twilightpsychology.com"
							target="_blank"
							rel="noopener noreferrer"
						>Twilight Psychology <ExternalLink className="h-3.5 w-3.5" aria-hidden="true" /></a>.
					</p>
				</FadeIn>
			</div>
		</section>

		<!-- ── WHO SHE HELPS ── -->
		<section class="home-section" aria-labelledby="clients-heading">
			<div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-10">
				<FadeIn>
					<p class="eyebrow">Who She Helps</p>
					<h2 id="clients-heading" class="max-w-2xl text-4xl leading-none text-ink sm:text-5xl">Clinicians at Every Stage</h2>
					<p class="mt-4 mb-8 max-w-2xl text-base leading-8 text-muted">
						From brand-new providers navigating their first credentialing application to seasoned practitioners untangling a billing mess or expanding into multi-state work.
					</p>
				</FadeIn>
				<FadeIn delay={200}>
					<div class="visual-grid">
						{populations.map((item) => (
							<span class="visual-chip">{item}</span>
						))}
					</div>
				</FadeIn>
			</div>
		</section>

		<!-- ── SERVICES ── -->
		<section id="services" class="home-section bg-section-tint" aria-labelledby="services-heading">
			<div class="mx-auto w-full max-w-6xl space-y-10 px-4 sm:px-6 lg:px-10">
				<FadeIn>
					<p class="eyebrow">What Heather Offers</p>
					<h2 id="services-heading" class="text-4xl leading-none text-ink sm:text-5xl">Two Ways to Work Together</h2>
					<p class="mt-4 max-w-2xl text-base leading-8 text-muted">
						Consulting and continuing education that connect directly to the realities of clinical practice.
					</p>
				</FadeIn>
				<div class="grid gap-6 lg:grid-cols-2">
					{serviceCards.map((service, i) => {
						const Icon = service.icon;
						return (
							<AnimatedCard href={service.href} index={i} className="service-card rounded-4xl p-8 hover:-translate-y-1">
								<div class="flex items-center gap-3">
									<div class="brand-icon-wrap">
										<Icon className="h-5 w-5" aria-hidden="true" />
									</div>
									<h3 class="mb-0 text-3xl leading-none text-ink">{service.title}</h3>
								</div>
								<p class="mt-5 max-w-xl text-base leading-8 text-muted">{service.description}</p>
								<span class="mt-8 inline-flex items-center gap-2 text-sm font-semibold text-accent">
									{service.cta}
								</span>
							</AnimatedCard>
						);
					})}
				</div>
			</div>
		</section>

		<!-- ── WHY HEATHER ── -->
		<section class="home-section" aria-labelledby="why-heading">
			<div class="mx-auto w-full max-w-6xl space-y-10 px-4 sm:px-6 lg:px-10">
				<FadeIn>
					<p class="eyebrow">Why Clinicians Choose Heather</p>
					<h2 id="why-heading" class="text-4xl leading-none text-ink sm:text-5xl">Built for Clinicians Who Want Useful Answers</h2>
				</FadeIn>
				<div class="grid gap-6 lg:grid-cols-3">
					{differentiators.map((item, i) => (
						<AnimatedCard index={i} stagger={140} className="differentiator-card rounded-[1.75rem] p-6">
							<h3 class="mb-0 text-2xl leading-tight text-ink">{item.title}</h3>
							<p class="mt-4 text-base leading-8 text-muted">{item.description}</p>
						</AnimatedCard>
					))}
				</div>
			</div>
		</section>

		<!-- ── RESOURCES: PRICING + FAQ ── -->
		<section class="home-section bg-section-tint" aria-label="Resources">
			<div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-10">
				<FadeIn>
					<p class="eyebrow">Before You Reach Out</p>
					<h2 class="text-4xl leading-none text-ink sm:text-5xl mb-10">Pricing &amp; FAQ</h2>
				</FadeIn>
				<div class="grid gap-6 lg:grid-cols-2">
					{resourceCards.map((card, i) => {
						const Icon = card.icon;
						return (
							<AnimatedCard href={card.href} index={i} stagger={120} className="rounded-4xl p-8">
								<div class="flex items-center gap-3 mb-4">
									<div class="brand-icon-wrap">
										<Icon className="h-5 w-5" aria-hidden="true" />
									</div>
									<h3 class="mb-0 text-2xl leading-none text-ink">{card.title}</h3>
								</div>
								<p class="text-base leading-8 text-muted">{card.description}</p>
								<span class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-accent">
									{card.cta}
								</span>
							</AnimatedCard>
						);
					})}
				</div>
			</div>
		</section>

		<!-- ── CONTACT ── -->
		<section id="contact" class="home-section">
			<div class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-10">
				<FadeIn class="premium-card rounded-4xl">
					<div class="grid gap-12 lg:grid-cols-[1fr_1.2fr] lg:gap-16">
						<div class="space-y-6">
							<div class="space-y-4">
								<p class="eyebrow">Ready to work together?</p>
								<h2 class="text-4xl leading-none text-ink sm:text-5xl">Let's talk about your practice needs.</h2>
								<p class="text-base leading-8 text-muted">
									Whether you need consulting on billing, credentialing, or PSYPACT — or you're interested in a CEU training — reach out and Heather will follow up to discuss the right next step.
								</p>
							</div>
							<div class="space-y-3 pt-2">
								<div class="flex items-center gap-3 text-sm font-semibold text-muted">
									<svg class="h-4 w-4 shrink-0 text-brand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
									<a href={`mailto:${contactInfo.email}`} class="hover:text-ink transition-colors">{contactInfo.email}</a>
								</div>
								<div class="flex items-center gap-3 text-sm font-semibold text-muted">
									<svg class="h-4 w-4 shrink-0 text-brand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13.5a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.56 3h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l.81-.81a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 17z"/></svg>
									<a href={`tel:${contactInfo.phone}`} class="hover:text-ink transition-colors">{contactInfo.phoneDisplay}</a>
								</div>
								<div class="flex items-center gap-3 text-sm font-semibold text-muted">
									<svg class="h-4 w-4 shrink-0 text-brand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>
									<span>Remote / Virtual Sessions</span>
								</div>
								<div class="flex items-center gap-3 text-sm font-semibold text-muted">
									<svg class="h-4 w-4 shrink-0 text-brand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
									<span>Response within 1–2 business days</span>
								</div>
							</div>
						</div>
						<div class="rounded-3xl border border-line-soft bg-surface p-6 shadow-medium sm:p-8">
							<ContactForm client:visible />
						</div>
					</div>
				</FadeIn>
			</div>
		</section>
	</main>
</Layout>

<style>
	.home-section {
		padding-block: clamp(3.5rem, 8vw, 5.5rem);
	}

	.section-rail {
		position: relative;
		padding-top: 1.25rem;
	}

	.section-rail::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0;
		width: min(9rem, 35vw);
		height: 2px;
		border-radius: 999px;
		background: linear-gradient(90deg, rgba(167, 139, 250, 0.18), rgba(167, 139, 250, 1), rgba(167, 139, 250, 0.18));
		background-size: 220% 100%;
		animation: railShift 8s ease-in-out infinite;
	}

	.service-card {
		position: relative;
		overflow: hidden;
	}

	.service-card::before {
		content: '';
		position: absolute;
		inset: 0 auto auto 0;
		height: 2px;
		width: 100%;
		border-radius: 999px;
		background: linear-gradient(90deg, transparent, rgba(167, 139, 250, 0.95), transparent);
		background-size: 200% 100%;
		animation: railShift 10s linear infinite;
	}

	.differentiator-card {
		position: relative;
		overflow: hidden;
	}

	.differentiator-card::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: inherit;
		pointer-events: none;
		background: linear-gradient(120deg, transparent 30%, rgba(167, 139, 250, 0.12) 50%, transparent 70%);
		transform: translateX(-140%);
		animation: sheen 9s ease-in-out infinite;
	}

	@keyframes railShift {
		to {
			background-position: 220% 0;
		}
	}

	@keyframes sheen {
		0%,
		40%,
		100% {
			transform: translateX(-140%);
		}
		60% {
			transform: translateX(140%);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.section-rail::before,
		.service-card::before,
		.differentiator-card::after {
			animation: none !important;
		}
	}
</style>
