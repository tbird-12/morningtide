---
import Layout from '../layouts/Layout.astro';
import FadeIn from '../components/FadeIn.tsx';
import AnimatedText from '../components/AnimatedText.tsx';
import AnimatedCard from '../components/AnimatedCard.tsx';
import { Briefcase, BookOpen, DollarSign, Check } from 'lucide-react';

const consultingFeatures = [
	'Insurance billing workflows and denial prevention',
	'Credentialing and paneling strategy',
	'Practice systems: intake, scheduling, consent workflows',
	'Transitioning to private-pay or hybrid models',
	'PSYPACT navigation and multi-state telehealth compliance',
	'EHR setup, EDI, NPI, CAQH, and credentialing panels',
	'Medicaid and Medicare practice management compliance',
];

const ceuFeatures = [
	'Live virtual sessions with interactive Q&A',
	'Practical clinical frameworks and assessment tools',
	'Diagnostic reasoning and differential diagnosis',
	'Neuro-affirming and culturally responsive approaches',
	'Custom on-site workshops for organizations',
	'Continuing education credits (available)',
];

const pricingCards = [
	{
		title: 'Practice Consulting',
		description: 'Tailored guidance for your specific practice challenges.',
		price: 'By Inquiry',
		icon: Briefcase,
		features: [
			'1-on-1 consulting via secure video',
			'Customized to your needs',
			'Billing & credentialing support',
			'PSYPACT & operations guidance',
			'Payment plans available',
		],
		cta: 'Get Pricing',
		ctaHref: '/#contact',
	},
	{
		title: 'CEU Trainings',
		description: 'Continuing education grounded in clinical practice.',
		price: 'Custom Pricing',
		icon: BookOpen,
		features: [
			'ADHD & Autism assessment trainings',
			'Virtual or on-site formats',
			'Multiple audience sizes supported',
			'Custom topics available',
			'CE credits included',
		],
		cta: 'Request Quote',
		ctaHref: '/#contact',
	},
];
---

<Layout
	title="Pricing | Morningtide Consulting and Collective"
	description="Pricing for practice consulting and CEU trainings. Flexible options for clinicians and organizations."
>
	<main id="main-content" class="page-main">
		<section class="hero-shell mx-auto max-w-6xl space-y-8">
			<FadeIn delay={0}>
				<p class="eyebrow">Pricing</p>
			</FadeIn>
			<AnimatedText
				text="Simple, Transparent Pricing for Consulting and Trainings"
				as="h1"
				split="word"
				stagger={50}
				delay={100}
				class="max-w-4xl text-5xl leading-none text-(--color-ink) sm:text-6xl"
			/>
			<FadeIn delay={400}>
				<p class="max-w-3xl text-lg leading-8 text-(--color-muted)">
					Pricing is tailored to scope and audience size. Payment plans available for larger engagements.
				</p>
			</FadeIn>
		</section>

		<section class="mx-auto mt-12 max-w-6xl space-y-10">
			<div class="grid gap-6 lg:grid-cols-2">
				{pricingCards.map((card, i) => {
					const Icon = card.icon;
					return (
						<AnimatedCard href={card.ctaHref} index={i} className="section-shell rounded-4xl p-8 hover:-translate-y-1">
							<div class="flex items-start justify-between">
								<div class="flex-1">
									<div class="flex items-center gap-3">
										<div class="flex h-11 w-11 items-center justify-center rounded-2xl bg-(--color-section-tint) text-(--color-brand)">
											<Icon className="h-5 w-5" aria-hidden="true" />
										</div>
										<h2 class="mb-0 text-3xl leading-none text-(--color-ink)">{card.title}</h2>
									</div>
									<p class="mt-3 text-base leading-8 text-(--color-muted)">{card.description}</p>
								</div>
							</div>
							<div class="mt-6 space-y-3">
								{card.features.map((feature) => (
									<div class="flex items-start gap-3">
										<Check className="mt-1 h-4 w-4 shrink-0 text-(--color-brand)" aria-hidden="true" />
										<span class="text-sm text-(--color-muted)">{feature}</span>
									</div>
								))}
							</div>
							<div class="mt-6 border-t border-(--color-line-soft) pt-6">
								<p class="text-sm font-semibold text-(--color-brand)">Investment</p>
								<p class="mt-2 text-2xl font-bold text-(--color-ink)">{card.price}</p>
								<p class="mt-1 text-xs text-(--color-muted)">Reach out for detailed pricing</p>
							</div>
							<span class="mt-6 inline-flex items-center text-sm font-semibold text-(--color-accent)">
								{card.cta} →
							</span>
						</AnimatedCard>
					);
				})}
			</div>
		</section>

		<section class="mx-auto mt-12 grid max-w-6xl gap-6 lg:grid-cols-2">
			<FadeIn class="section-shell rounded-4xl p-8">
				<p class="eyebrow">Practice Consulting Includes</p>
				<ul class="mt-6 space-y-3 text-sm leading-7 text-(--color-muted)">
					{consultingFeatures.map((feature) => (
						<li class="flex gap-3">
							<span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-(--color-brand)"></span>
							<span>{feature}</span>
						</li>
					))}
				</ul>
			</FadeIn>

			<FadeIn class="section-shell rounded-4xl p-8">
				<p class="eyebrow">CEU Trainings Include</p>
				<ul class="mt-6 space-y-3 text-sm leading-7 text-(--color-muted)">
					{ceuFeatures.map((feature) => (
						<li class="flex gap-3">
							<span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-(--color-brand)"></span>
							<span>{feature}</span>
						</li>
					))}
				</ul>
			</FadeIn>
		</section>

		<section class="cta-strip mx-auto mt-10 max-w-6xl">
			<div class="grid gap-8 lg:grid-cols-3">
				<div>
					<p class="eyebrow">Flexible Payment</p>
					<p class="mt-4 text-base leading-8 text-(--color-muted)">Payment plans available for larger consulting engagements and organization-wide trainings. Credit cards, Zelle, and Venmo accepted.</p>
				</div>
				<div>
					<p class="eyebrow">Custom Solutions</p>
					<p class="mt-4 text-base leading-8 text-(--color-muted)">Don't see a package that fits? Contact us to discuss your specific needs, and we can develop a customized program.</p>
				</div>
				<div>
					<p class="eyebrow">Next Step</p>
					<a class="mt-4 inline-flex min-h-11 rounded-full bg-(--color-accent) px-5 py-3 text-sm font-semibold text-(--color-button-ink) shadow-(--shadow-brand) transition-all duration-300 hover:-translate-y-0.5 hover:shadow-lg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--color-brand)" href="/#contact">Schedule a consultation</a>
				</div>
			</div>
		</section>
	</main>
</Layout>
